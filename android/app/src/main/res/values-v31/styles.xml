<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LaunchTheme: compat splash screen for API 31+ (Android 12+) -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <!-- Compat attribute (used by core-splashscreen library) -->
        <item name="windowSplashScreenBackground">@color/launch_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/launch_background</item>
        <!-- Framework attribute (used by Android 12+ system splash screen) -->
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_background</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>

    <!-- NormalTheme: plain dark background after splash, before Flutter renders -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
    </style>
</resources>
